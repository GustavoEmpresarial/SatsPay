# Build context for Dockerfile.api-server / Dockerfile.worker.
# On the VM the context is /root/bitcosats, which also holds the production
# `.env` read by docker compose — it must never reach a build layer.

# Secrets & wallet backups
secrets/
SEED_BACKUP.*
**/hd_wallets.json
**/master_wallet_backup.json
**/seed_phrase_backup.txt
**/*.key
**/*.pem
**/*.p12
**/*.pfx
.env
.env.*
**/.env
**/.env.*
**/deploy.credentials.py

# Build artifacts / deps
target/
target-bookworm/
**/target/
client/
node_modules/

# Repo metadata & non-build inputs
.git/
.github/
docs/
storage/
scripts/
deploy/
