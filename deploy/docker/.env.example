# BitcoSats Docker Compose Environment Configuration
# Salve uma cópia deste arquivo como .env no mesmo diretório antes do deploy

# PostgreSQL
POSTGRES_USER=bitcosats
POSTGRES_PASSWORD=bitcosats_dev_password
POSTGRES_DB=bitcosats

# Autenticação e Criptografia (MANTENHA ESTES VALORES FIXOS ENTRE DEPLOYS)
JWT_ACCESS_SECRET=bitcosats-permanent-dev-secret-key-32chars!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Deploy 4: blank users.email after HMAC+email_enc backfill is green. HOUSE stays.
# PII_BLANK_EMAIL=true
ADMIN_EMAILS=admin@bitcosats.local

# Portas de Acesso
API_HOST_BIND=127.0.0.1
API_HOST_PORT=4500
CLIENT_HOST_BIND=0.0.0.0
CLIENT_HOST_PORT=8080

# Carteiras — ADR 0012. Gere tudo com (mnemonics via stdin, nunca argv):
#   cargo run -q -p worker --example custody_setup
# Público (api-server + worker):
# DEPOSIT_XPUB_BTC=xpub...   (um por moeda: BTC LTC DOGE BCH POL DGB USDT USDC ZER PEPE)
# HOT_ADDRESS_BTC=bc1...     (um por moeda, inclusive SOL)
# Só worker — produção aceita apenas *_ENC (texto claro = boot FATAL):
# WALLET_ENCRYPTION_KEY=     (opcional; sela os *_ENC com chave que a API não vê)
# DEPOSIT_MNEMONIC_ENC=
# HOT_MNEMONIC_ENC=
# Dev/test apenas: DEPOSIT_MNEMONIC= / HOT_MNEMONIC= / CHAIN_DEPOSIT_XPUB=

# Self-hosted DigiByte Core (wallet disabled → scantxoutset). Empty = Insight fallback.
# Node VM does not run digibyted (RAM). Leave unset in prod until a dedicated host exists.
# DGB_RPC_URL=

# Self-hosted zerod (required for ZER withdraw). Explorer is watch/fallback only.
# Only set when zerod has peers and is not in IBD. Empty = deposit via explorer; withdraw fail-closed.
# ZER_RPC_URL=
# ZER_EXPLORER_API=https://zerochain.info/api
# ZER_EXPLORER_API_KEY=

# PEPE (BEP-20 na BNB Smart Chain, chain id 56). Gas do saque e do sweep sai em BNB
# da mesma hot EVM (m/44'/60'/0'/0/0). Sem BNB na hot o worker não assina.
# BSC_RPC_URL=https://bsc-rpc.publicnode.com
# BSC_DEPOSIT_LOOKBACK_BLOCKS=2000

# Swap. Taxa SatsPay diferencial: 25 bps (0,25%).
# SWAPKIT_ENABLED=true
# SWAPKIT_API_KEY=
# RELAY_ENABLED=true
# RELAY_API_KEY=
# RELAY_BASE_URL=https://api.relay.link
# ChangeNOW L1 instant exchange (BTC/LTC/DOGE/BCH/DGB ↔ L2/SOL)
# CHANGENOW_ENABLED=true
# CHANGENOW_API_KEY=
# CHANGENOW_BASE_URL=https://api.changenow.io/v2
# SWAP_HOUSE_ENABLED=false
# SWAP_PLATFORM_FEE_BPS_SAME=25
# SWAP_PLATFORM_FEE_BPS_CROSS=25

# Telemetria: webhook opcional (Discord/Slack) para CRITICAL/FATAL novos + spikes
# TELEMETRY_ALERT_WEBHOOK_URL=

# Imagens
API_IMAGE=bitcosats/api-server:dev
CLIENT_IMAGE=bitcosats/client:dev
WORKER_IMAGE=bitcosats/worker:dev
