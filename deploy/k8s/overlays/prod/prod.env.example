# Values filled by CI / cluster operator before apply — never commit a filled
# `prod.env` (it is gitignored). Copy this file:
#   cp prod.env.example prod.env
# then edit `kustomization.yaml` configMapGenerator envs to `prod.env`, or
# keep using this example only for dry-run builds (sentinels below).

# Git commit SHA (or registry digest tag) of the image CI built — never `latest`.
IMAGE_TAG=__SET_BY_CI__

# Public DNS name for Ingress TLS host (matches cert-manager Certificate).
API_HOSTNAME=__SET_BY_OPERATOR__

# HashiCorp Vault address for External Secrets SecretStore.
VAULT_ADDR=__SET_BY_OPERATOR__

# Full Barman destinationPath URI, e.g. s3://<bucket>/bitcosats-postgres
# (must match credentials in postgres-backup-credentials).
POSTGRES_BACKUP_S3_URI=__SET_BY_OPERATOR__

# ACME contact email for cert-manager ClusterIssuer (Let's Encrypt).
CLUSTER_ISSUER_EMAIL=__SET_BY_OPERATOR__
