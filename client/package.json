{
  "name": "bitcosats-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:smoke": "vitest run tests/smoke",
    "test:batch": "vitest run tests/unit tests/smoke",
    "test:e2e": "playwright test",
    "test:pages": "vitest run tests/unit/pages",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:logic": "vitest run --config vitest.logic.config.ts --coverage",
    "test:coverage:full": "vitest run tests/unit tests/api --coverage",
    "test:property": "vitest run tests/unit/property tests/unit/acceptance",
    "test:contract": "vitest run tests/unit/contract",
    "test:api": "vitest run tests/api",
    "test:security": "vitest run tests/unit/security tests/unit/lib/secretsHygiene.test.ts tests/unit/lib/securityControls.test.ts tests/unit/lib/nginxProxyHeaders.test.ts",
    "test:pyramid": "vitest run tests/unit && vitest run tests/api",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.60.5",
    "bootstrap-icons": "^1.13.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.9",
    "react-router-dom": "^7.18.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fast-check": "^4.10.0",
    "jsdom": "^26.1.0",
    "pg": "^8.13.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
